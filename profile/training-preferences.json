{
  "schema_version": 1,
  "recording_preferences": {
    "information_collection": {
      "mode": "agent_led_dialogue",
      "one_question_at_a_time": true,
      "ask_only_missing_information": true,
      "reuse_confirmed_preferences": true,
      "optional_information_can_be_skipped": true,
      "meaning": "通过 Agent 与用户逐轮问答补充训练信息；先问必要缺口，再按相关性补充可选信息，不改变已有动作记录原则。",
      "status": "user_confirmed",
      "confirmed_on": "2026-09-05"
    },
    "exercise_alignment": {
      "required_before_write": true,
      "match_sources": ["catalog", "workout_history"],
      "confirm_when_uncertain": true,
      "reuse_existing_exercise_id": true,
      "create_new_only_after_no_match_and_confirmation": true,
      "trend_key": ["exercise_id", "variant", "equipment", "sequence"],
      "meaning": "动作名称可以变化，但同一基本动作必须保持唯一 ID；长期趋势只比较变体、器械和顺序角色一致的记录。",
      "status": "user_confirmed",
      "confirmed_on": "2026-08-05"
    },
    "rir_default": {
      "missing_means": 0,
      "meaning": "用户确认所有工作组均为力竭；未报告 RIR 时默认按 0 记录，不再询问。",
      "status": "user_confirmed",
      "confirmed_on": "2026-08-18"
    }
  },
  "progression_preferences": {
    "priority_order": ["movement_quality", "quantity", "load"],
    "movement_quality_first": {
      "meaning": "动作质量是第一绝对重要的训练标准，远优于完成数量和工作重量。只有动作质量保持或提高时，增加次数、组数或重量才视为有效进步。",
      "status": "user_confirmed",
      "confirmed_on": "2026-08-24"
    },
    "quality_improvement_with_load_reduction": {
      "classification": "major_progress",
      "meaning": "当用户明确报告因动作优化而降低工作重量，并确认动作质量明显提高时，将其视为大的进步而不是退步。客观重量仍按实际值记录，并以优化后的动作质量和当前重量建立新的可比基线。",
      "do_not_infer_from_load_drop_alone": true,
      "status": "user_confirmed",
      "confirmed_on": "2026-08-24"
    }
  },
  "exercise_order": {
    "preserve_reported_order": true,
    "meaning": "动作顺序属于训练事实；后补确认的动作仍使用用户最初报告的位置。"
  },
  "calendar_interpretation": {
    "no_workout_record_is_rest_day": true,
    "meaning": "没有训练记录的日期按休息日处理；不额外创建空训练日志。",
    "status": "user_preference"
  },
  "priority_rotation": {
    "chest_back_day": {
      "enabled": true,
      "strategy": "alternate_first_muscle_group",
      "last_completed_priority": "back",
